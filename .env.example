# ──────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────
# Local Docker:       postgresql+psycopg2://postgres:postgres@db:5432/society_db
# Render (Internal):  postgresql+psycopg2://user:pass@host/dbname
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/society_db

# ──────────────────────────────────────────────
# SECURITY
# ──────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# ──────────────────────────────────────────────
# SUPABASE STORAGE  (Complaint Photo Uploads)
# ──────────────────────────────────────────────
# Create a project at https://supabase.com → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
# Use the service_role key (NOT the anon key) for server-side access
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Create a private Storage bucket with this exact name
SUPABASE_STORAGE_BUCKET=complaint-photos

# ──────────────────────────────────────────────
# EMAIL  (Resend Transactional API)
# ──────────────────────────────────────────────
# Sign up at https://resend.com → API Keys → Create Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Use a verified domain OR the Resend sandbox: onboarding@resend.dev
EMAIL_FROM=onboarding@resend.dev

# ──────────────────────────────────────────────
# FRONTEND  (Next.js public env — prefix NEXT_PUBLIC_)
# ──────────────────────────────────────────────
# Set this to your deployed backend URL or http://localhost:8000 for local dev
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com